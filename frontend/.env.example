# WhyEV Frontend — Environment Variables Example
# Copy this file to .env.local for local development
#
# IMPORTANT: .env.local is in .gitignore and must NEVER be committed.
# For production (Vercel), set these variables in the Vercel dashboard:
#   Settings → Environment Variables → (your project) → Production
#
# If NEXT_PUBLIC_API_URL is NOT set in Vercel, the code defaults to:
#   https://whyev-backend.onrender.com/api/v1
# which is the correct production backend. Only override if you have a
# different production backend URL.

# ── Backend API URL ──────────────────────────────────────────────────────────
# Development (local):
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Production (Vercel): set to your deployed backend URL, e.g.:
# NEXT_PUBLIC_API_URL=https://whyev-backend.onrender.com/api/v1
# WARNING: Never set this to http://localhost:8000 in production.

# ── Application Domain ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Environment Mode ─────────────────────────────────────────────────────────
NEXT_PUBLIC_ENVIRONMENT=development

# ── Supabase Auth (required for real Google OAuth) ───────────────────────────
# From: Supabase Dashboard → Project Settings → API
# The ANON key is safe to expose in the browser (it is the "publishable" key).
# NEVER put the SERVICE ROLE key here — it must remain server-side only.
NEXT_PUBLIC_SUPABASE_URL=https://<your-project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>
