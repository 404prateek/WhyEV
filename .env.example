# WhyEV Backend — environment variables (MVP)
# Copy this file to .env and fill in your real values.

# ─────────────────────────────────────────────────────────────────────────────
# APP
# ─────────────────────────────────────────────────────────────────────────────
# ENVIRONMENT: "development" shows detailed errors and /docs page.
#              Set to "production" before going live.
ENVIRONMENT=development

# DEBUG: "true" prints all SQL queries and enables hot-reload.
#        Set to "false" in production.
DEBUG=true

# SECRET_KEY: Master secret for the app. Generate a strong one:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme-replace-with-64-char-hex

# CORS_ORIGINS: comma-separated list of frontend URLs allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ─────────────────────────────────────────────────────────────────────────────
# DATABASE (Supabase or any Postgres)
# ─────────────────────────────────────────────────────────────────────────────
# For Supabase: go to Project Settings → Database → Connection String
# Use the "Session mode" URL (port 5432) for this backend.
DATABASE_URL=postgresql+asyncpg://postgres:your-password@db.xxxx.supabase.co:5432/postgres

# ─────────────────────────────────────────────────────────────────────────────
# JWT (login tokens)
# ─────────────────────────────────────────────────────────────────────────────
# JWT_SECRET: Signs your login tokens. Keep secret — anyone with this can
#             forge logins. Generate with: secrets.token_hex(32)
JWT_SECRET=changeme-replace-with-another-64-char-hex

# JWT_ACCESS_TTL: Access token lifetime in seconds (900 = 15 minutes)
JWT_ACCESS_TTL=900

# JWT_REFRESH_TTL: Refresh token lifetime in seconds (2592000 = 30 days)
JWT_REFRESH_TTL=2592000

# ─────────────────────────────────────────────────────────────────────────────
# GOOGLE OAUTH (only auth method)
# ─────────────────────────────────────────────────────────────────────────────
# Get these from: Google Cloud Console → APIs & Services → Credentials
#   → Create OAuth 2.0 Client ID (Web application)
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret

# ─────────────────────────────────────────────────────────────────────────────
# LLM — Groq (free, open-source models)
# ─────────────────────────────────────────────────────────────────────────────
# Sign up free at console.groq.com → API Keys → Create key
# Free tier: ~14,400 requests/day — more than enough for MVP
GROQ_API_KEY=gsk_your-groq-api-key-here

# Agent model: powerful model for final responses (Llama 3.3 70B)
LLM_AGENT_MODEL=llama-3.3-70b-versatile

# Classifier model: fast/cheap model for routing user intent (Llama 3.1 8B)
LLM_CLASSIFIER_MODEL=llama-3.1-8b-instant

# ─────────────────────────────────────────────────────────────────────────────
# OBSERVABILITY
# ─────────────────────────────────────────────────────────────────────────────
# Sentry catches backend errors and sends you alerts. Free tier is fine.
# Sign up at sentry.io → Create project → copy DSN. Leave empty to disable.
SENTRY_DSN=
