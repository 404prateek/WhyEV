# WhyEV Backend — environment variables
# Copy to .env and fill in real values before running

# App
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=changeme-32-chars-minimum-replace-now

# Database
DATABASE_URL=postgresql+asyncpg://whyev:whyev@localhost:5432/whyev

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# JWT
JWT_SECRET=changeme-jwt-secret-replace-now
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# SMS (choose one)
SMS_GATEWAY=msg91
SMS_API_KEY=
SMS_SENDER_ID=WHYEV
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_AGENT_MODEL=claude-sonnet-4-5
ANTHROPIC_CLASSIFIER_MODEL=claude-haiku-4-5

# S3 / Cloudflare R2
S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=whyev-assets
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto

# Observability
SENTRY_DSN=

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
